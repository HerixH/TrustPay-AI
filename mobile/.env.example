# Copy to `.env` for local web/production-like builds (never commit `.env`).
#
# --- Vercel (optional if app.json extra.trustpayApiUrl is set) ---
# Name: EXPO_PUBLIC_TRUSTPAY_API_URL
# Value: same as below (no trailing slash). Redeploy after changes.
