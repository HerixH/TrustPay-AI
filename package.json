{
  "name": "trustpay-ai",
  "private": true,
  "description": "Run the Expo app from the mobile/ folder",
  "scripts": {
    "start": "npm run start --prefix mobile",
    "android": "npm run android --prefix mobile",
    "ios": "npm run ios --prefix mobile",
    "web": "npm run web --prefix mobile",
    "url": "npm run url --prefix mobile",
    "start:lan": "npm run start:lan --prefix mobile",
    "start:tunnel": "npm run start:tunnel --prefix mobile",
    "backend": "cargo run --manifest-path backend/Cargo.toml",
    "deploy:escrow": "powershell -ExecutionPolicy Bypass -File scripts/deploy-escrow-devnet.ps1",
    "eas:secret:set-api": "npm run eas:secret:set-api --prefix mobile"
  }
}
