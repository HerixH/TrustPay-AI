# Local: defaults below. Railway: set DATABASE_PATH=/data/trustpay.sqlite and attach a volume at /data.
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=trustpay.sqlite

# Must match Anchor `declare_id!` after `anchor keys sync`
TRUSTPAY_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFDSn

SOLANA_RPC_URL=https://api.devnet.solana.com

# --- External AI (use what you need; everything else can stay empty) ---

# ElevenLabs: only required for "Voice contract" MP3 audio.
# User API keys start with sk_ (ElevenLabs dashboard → API keys). Not the Agents SDK.
# Validate: .\scripts\test-elevenlabs.ps1 from backend/ (calls GET /v1/user).
# If TTS fails, check Railway logs for "ElevenLabs TTS failed" (HTTP body from ElevenLabs).
# Redeploy after changing keys. Trim pasted values (no spaces). Try model:
# eleven_flash_v2_5 (default) or eleven_multilingual_v2 if your voice needs it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# OpenAI: OPTIONAL. Leave blank to skip it entirely — "Analyze chat" still runs
# on local keyword heuristics (no OpenAI calls).
OPENAI_API_KEY=

# Logging
RUST_LOG=info,tower_http=warn
